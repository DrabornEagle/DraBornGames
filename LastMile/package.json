{
  "name": "dkd-draborngo-lastmile",
  "version": "0.7.5",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --go --localhost",
    "start:lan": "expo start --go --lan",
    "start:clear": "expo start --go --localhost --clear",
    "start:dev-client": "expo start --dev-client --lan",
    "build:game": "node scripts/dkd-build-game-v07.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/dkd-preview.mjs",
    "sync": "bash scripts/dkd-sync.sh",
    "sync:watch": "bash scripts/dkd-sync.sh watch",
    "android:development": "bash scripts/dkd-android-output.sh development",
    "android:apk": "bash scripts/dkd-android-output.sh apk",
    "android:aab": "bash scripts/dkd-android-output.sh aab",
    "verify": "npm run build:game && npm test && npm run typecheck && expo install --check",
    "build:web": "npm run build:game && node scripts/dkd-build-web.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.20",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.16",
    "expo-sharing": "~57.0.18",
    "expo-speech": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1",
    "three": "0.172.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "fast-xml-parser": "^5.5.8",
    "jsdom": "^26.1.0",
    "terser": "^5.44.0",
    "typescript": "~5.9.2"
  }
}
