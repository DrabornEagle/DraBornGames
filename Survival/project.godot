config_version=5

[application]
config/name="DraBornGames: Survival"
config/version="0.1.0"
config/project_settings_override="user://renderer.cfg"
config/quit_on_go_back=false
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://assets/icons/icon.svg"

[autoload]
DB="*res://scripts/core/database.gd"
Settings="*res://scripts/core/settings.gd"
Inventory="*res://scripts/inventory/inventory_manager.gd"
Quests="*res://scripts/quests/quest_manager.gd"
Saves="*res://scripts/save/save_manager.gd"
Controls="*res://scripts/player/input_hub.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0
window/size/resizable=true

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
rendering_device/fallback_to_opengl3=true
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/positional_shadow/atlas_size=1024
anti_aliasing/quality/msaa_3d=0
scaling_3d/scale=0.85
environment/defaults/default_clear_color=Color(0.14,0.23,0.27,1)

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]
3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false
