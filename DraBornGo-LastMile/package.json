    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-webview": "13.16.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
